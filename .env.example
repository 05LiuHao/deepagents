# ============================================================
# 环境变量模板
# 使用方法：复制本文件为 .env，然后填入真实值
#     cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，请勿提交到仓库
# ============================================================

# ---------- RAGFlow 知识库 ----------
RAGFLOW_API_URL=
RAGFLOW_API_KEY=

# ---------- 大模型服务（OpenAI 兼容接口）----------
# 示例：阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=

# 各档位模型名称
LLM_QWEN2.5=
LLM_QWEN3=
LLM_QWEN_MAX=

# ---------- 联网搜索（Tavily）----------
TAVILY_API_KEY=

# ---------- MySQL 数据库 ----------
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
